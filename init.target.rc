import /system/etc/init/init.sdv_core_base.rc

on property:dev.bootcomplete=1
    exec u:r:vendor_modprobe:s0 -- vendor/bin/modprobe -a -d /vendor_dlkm/lib/modules/ virtio_net
    exec u:r:vendor_modprobe:s0 -- vendor/bin/modprobe -a -d /vendor_dlkm/lib/modules/ stub_dlkm
    exec u:r:vendor_modprobe:s0 -- vendor/bin/modprobe -a -d /vendor_dlkm/lib/modules/ machine_dlkm
    exec - root root -- /system/bin/ifconfig eth0 192.168.1.2 netmask 255.255.255.0
    exec - root root -- /system/bin/ip route add default via 192.168.1.2 dev eth0
    exec - root root -- /system/bin/ifconfig eth0 up
    exec - root root -- /system/bin/ip rule add from all lookup main
    setprop service.adb.tcp.port 5555
    setprop service.adb.listen_addrs tcp:5555
    start adbd
    mkdir /dev/socket/agm 0777 system system

on post-fs-data
    # load kernel modules
    write /dev/kmsg "gki.modprobe"
    exec_start gki.modprobe
    write /dev/kmsg "vendor.modprobe"
    #exec_start vendor.modprobe

service gki.modprobe /vendor/bin/system_dlkm_modprobe.sh
    class main
    user root
    group root system
    disabled
    stdio_to_kmsg
    seclabel u:r:vendor_modprobe:s0
    oneshot

service vendor.modprobe /vendor/bin/vendor_modprobe.sh
    class main
    user root
    group root system
    oneshot
    disabled
    stdio_to_kmsg
    seclabel u:r:vendor_modprobe:s0
    import service_dlkm
    on service_dlkm_started

service vendor.agm-1-0 /vendor/bin/hw/vendor.qti.hardware.AGMIPC@1.0-service
    class core
    user system
    interface vendor.qti.hardware.AGMIPC@1.0::IAGM default
    # media gid needed for /dev/fm (radio) and for /data/misc/media (tee)
    group system audio media mediadrm oem_2901 wakelock
    capabilities BLOCK_SUSPEND SYS_NICE
    disabled

service console_qc /system/bin/sh
    class core
    console
    disabled
    user shell
    group shell log readproc
    seclabel u:r:shell:s0
    setenv HOSTNAME console

# Disable the dt_agent from Google
service dt_agent /system/bin/true
    class core
    oneshot
    override
    disabled
    user system
    group system

# Declare and start the SDV Data Tunnel agent with an increased file descriptor limit
service dt_agent_cdc /system_ext/bin/dt_agent
    class core
    disabled
    user shell
    group shell
    rlimit nofile 32768 32768

# Start the SDV Data Tunnel agent
on property:dev.bootcomplete=1
    start dt_agent_cdc

on init
    start console_qc
    exec u:r:vendor_init-qti-AGMIPC-sh:s0 -- /vendor/bin/init.qti.AGMIPC.sh

on property:dev.bootcomplete=1 && property:ro.sdv.vsock_local_cid=*
    start sdv_someip_broker_agent

# Declare and start the SDV SOME/IP stack agent.
service sdv_someip_stack_agent /vendor/bin/qc_sdv_someip_stack_agent
    class core
    disabled
    user system
    group system
    setenv VSOMEIP_CONFIGURATION_vsomeip_vlan1500 /vendor/etc/someip/vsomeip_vlan1500.json
    setenv VSOMEIP_CONFIGURATION_vsomeip_vlan1510 /vendor/etc/someip/vsomeip_vlan1510.json

on property:dev.bootcomplete=1 && property:ro.sdv.vsock_local_cid=*
    mkdir /data/vendor/someip 0770 system system
    start sdv_someip_stack_agent

on early-init && property:ro.build.type=userdebug
    # Create tmpfs for use by the shell user.
    mount tmpfs tmpfs /tmp nosuid nodev rw
    restorecon /tmp
    chown shell shell /tmp
    chmod 0771 /tmp
