#Allow for transition from init domain to agmservice

type vendor_agmplay, domain;

type vendor_agmplay_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_agmservice_qti)

init_daemon_domain(vendor_agmplay)

# Add hwservice related rules
hal_attribute_hwservice(hal_audio, vendor_agm_hwservice)

#Allow access to agm device nodes
allow vendor_agmservice_qti vendor_agm_device:chr_file rw_file_perms;

# Allocate DMA-BUF Heap memory
allow vendor_agmservice_qti dmabuf_system_heap_device:chr_file rw_file_perms;
allow vendor_agmservice_qti vendor_dmabuf_system_heap_device:chr_file rw_file_perms;

#Allow access to uncached dmabuf
allow vendor_agmservice_qti vendor_dmabuf_system_uncached_heap_device:chr_file rw_file_perms;


#Allow qipc socket access for servreg communication
allow vendor_agmservice_qti self:qipcrtr_socket create_socket_perms_no_ioctl;

# agm audio thread needs RT scheduling for LL/ULL audio, allow sys_nice
allow vendor_agmservice_qti self:global_capability_class_set sys_nice;

#r_dir_file(vendor_agmservice_qti, proc_asound)

allow vendor_agmservice_qti proc_asound:dir search;
allow vendor_agmservice_qti proc_asound:file r_file_perms;
allow vendor_agmservice_qti self:process setcurrent;
userdebug_or_eng(`
allow vendor_agmservice_qti kmsg_debug_device:chr_file {open write};
')

r_dir_file(vendor_agmplay, proc_asound)
binder_call(vendor_agmplay, vendor_agmservice_qti)
binder_call(vendor_agmservice_qti, vendor_agmplay)

allow vendor_agmplay audio_device:dir r_dir_perms;
allow vendor_agmplay audio_device:chr_file rw_file_perms;
get_prop(vendor_agmplay, vendor_audio_prop)
get_prop(vendor_agmplay, hwservicemanager_prop)

allow vendor_agmplay vendor_sysfs_kpi:file w_file_perms;
allow vendor_agmplay vendor_sysfs_sndcard:file {open read write rw_file_perms};
allow vendor_agmplay vendor_agmplay:qipcrtr_socket create;

userdebug_or_eng(`
allow vendor_agmplay kmsg_debug_device:chr_file {open write};
')

#socket permission agmplay boot
allow vendor_agmplay socket_device:sock_file { write setattr create};
allow vendor_agmplay socket_device:dir { write add_name };

#Allow socket access
allow vendor_agmservice_qti socket_device:dir { search write add_name remove_name };
allow vendor_agmservice_qti socket_device:sock_file { create write unlink setattr};