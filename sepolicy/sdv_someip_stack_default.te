type sdv_someip_stack_default, domain;
typeattribute sdv_someip_stack_default mlstrustedsubject;
type sdv_someip_stack_default_exec, exec_type, file_type, vendor_file_type;
init_daemon_domain(sdv_someip_stack_default)

# Allow the sdv_someip_stack_default domain to use Binder IPC
binder_use(sdv_someip_stack_default)

# SOME/IP agent can use sockets
net_domain(sdv_someip_stack_default)

typeattribute sdv_someip_stack_default sdv_someip_stack_server;

# someip log file access in userdebug mode
userdebug_or_eng(`
allow sdv_someip_stack_default vendor_someip_data_file:dir { add_name search write remove_name };
allow sdv_someip_stack_default vendor_someip_data_file:file { create lock open write append getattr };
')
# someip sock file
allow sdv_someip_stack_default vendor_someip_sock_file:dir { add_name search write remove_name };
allow sdv_someip_stack_default vendor_someip_sock_file:file { create lock open write };
allow sdv_someip_stack_default vendor_someip_sock_file:sock_file { create setattr write unlink };
